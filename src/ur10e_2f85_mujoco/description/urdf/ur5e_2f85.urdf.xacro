      <geometry>
        <mesh filename="${environment_mesh_root}/sigmund_table.stl"/>
      </geometry>
      <material name="table_gray"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="${environment_mesh_root}/sigmund_table.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="table_1_joint" type="fixed">
