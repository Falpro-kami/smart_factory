<?xml version="1.0"?>
<robot name="ur5e_2f85" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="disable_rendering" default="$(arg headless)"/>

  <material name="ur_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="ur_blue">
    <color rgba="0.33 0.66 0.92 1.0"/>
  </material>
  <material name="ur_linkgray">
    <color rgba="0.88 0.88 0.88 1.0"/>
  </material>
  <material name="ur_jointgray">
    <color rgba="0.36 0.36 0.36 1.0"/>
  </material>
  <material name="gripper_black">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="gripper_gray">
    <color rgba="0.56 0.56 0.56 1.0"/>
  </material>
  <material name="table_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="cube_red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>
  <xacro:property name="ur5e_visual_mesh_root" value="package://ur10e_2f85_mujoco/description/mjcf/robot/official/universal_robots_ur5e/assets"/>
  <xacro:property name="ur5_collision_mesh_root" value="package://ur10e_2f85_mujoco/description/meshes/ur5/collision"/>
