    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gripper_right_silicone_pad">
  </link>

  <joint name="right_silicone_pad_joint" type="fixed">
    <parent link="gripper_right_pad"/>
    <child link="gripper_right_silicone_pad"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gripper_left_silicone_pad">
  </link>

  <joint name="left_silicone_pad_joint" type="fixed">
    <parent link="gripper_left_pad"/>
    <child link="gripper_left_silicone_pad"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="pinch"/>
  <joint name="pinch_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="pinch"/>
    <origin xyz="0.1488 0 -0.0038" rpy="0 0 0"/>
  </joint>

  <link name="tool_frame"/>
  <joint name="tool_frame_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="tool_frame"/>
    <origin xyz="0.1488 0 -0.0038" rpy="0 1.57079632679 0"/>
  </joint>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find ur10e_2f85_mujoco)/description/mjcf/ur5e_2f85_scene.xml</param>
      <param name="sim_speed_factor">1.0</param>
      <param name="headless">$(arg headless)</param>
      <param name="disable_rendering">$(arg disable_rendering)</param>
      <param name="camera_publish_rate">6.0</param>
    </hardware>

    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_driver_joint">
      <param name="mujoco_actuator">fingers_actuator</param>
      <param name="mujoco_actuator_scale">318.75</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <sensor name="table_overview">
      <param name="frame_name">world_frame</param>
      <param name="info_topic">/table_overview/camera_info</param>
      <param name="image_topic">/table_overview/color/image_raw</param>
      <param name="depth_topic">/table_overview/depth/image_raw</param>
    </sensor>
  </ros2_control>
</robot>
