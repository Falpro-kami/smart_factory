  <xacro:property name="gripper_finger_collision_size" value="0.06 0.016 0.016"/>
  <xacro:property name="gripper_tip_collision_size" value="0.038 0.018 0.018"/>

  <link name="world"/>
  <link name="world_frame"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.74" rpy="0 0 0"/>
  </joint>

  <joint name="world_frame_joint" type="fixed">
    <parent link="world"/>
    <child link="world_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="table_1">
