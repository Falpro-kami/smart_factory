  <xacro:property name="robotiq_coupler_mesh" value="package://ur10e_2f85_mujoco/description/meshes/robotiq/robotiq_85_coupler.stl"/>
  <xacro:property name="environment_mesh_root" value="package://ur10e_2f85_mujoco/description/meshes/environment"/>
  <xacro:property name="gripper_mount_collision_size" value="0.07 0.07 0.01"/>
  <xacro:property name="gripper_base_collision_size" value="0.08 0.08 0.06"/>
  <xacro:property name="gripper_knuckle_collision_size" value="0.048 0.018 0.018"/>
