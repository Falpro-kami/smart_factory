<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur10e_2f85_robot">

  <!-- Whether or not to use PID control -->
  <xacro:arg name="use_pid" default="false"/>
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="use_mjcf_from_topic" default="false"/>
  <xacro:arg name="use_transmissions" default="false"/>

  <link name="world"/>

  <material name="ur_blue">
    <color rgba="0.49 0.678 0.8 1.0"/>
  </material>
  <material name="ur_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <link name="base"/>
  <joint name="base_link" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="7.778"/>
      <inertia ixx="0.0314743" ixy="0.0" ixz="0.0" iyy="0.0314743" iyz="0.0" izz="0.0218756"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.16"/>
      </geometry>
      <material name="ur_gray"/>
    </visual>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.181" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="330"/>
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0 0 0.3065" rpy="0 0 0"/>
      <mass value="12.93"/>
      <inertia ixx="0.423074" ixy="0.0" ixz="0.0" iyy="0.423074" iyz="0.0" izz="0.0363656"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.12 0.12 0.65"/>
      </geometry>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <material name="ur_blue"/>
    </visual>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.176 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="330"/>
  </joint>

  <link name="forearm_link">
    <inertial>
      <origin xyz="0 0 0.2855" rpy="0 0 0"/>
      <mass value="3.87"/>
      <inertia ixx="0.11059" ixy="0.0" ixz="0.0" iyy="0.11059" iyz="0.0" izz="0.0108844"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.6"/>
      </geometry>
      <origin xyz="0 0 0.285" rpy="0 0 0"/>
      <material name="ur_blue"/>
    </visual>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.137 0.613" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="150"/>
  </joint>

  <link name="wrist_1_link">
    <inertial>
      <origin xyz="0 0.135 0" rpy="1.5708 0 0"/>
      <mass value="1.96"/>
      <inertia ixx="0.0055125" ixy="0.0" ixz="0.0" iyy="0.00510825" iyz="0.0" izz="0.00510825"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.18"/>
      </geometry>
      <origin xyz="0 0.09 0" rpy="1.5708 0 0"/>
      <material name="ur_gray"/>
    </visual>
  </link>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.571" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="56"/>
  </joint>

  <link name="wrist_2_link">
    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="1.96"/>
      <inertia ixx="0.0055125" ixy="0.0" ixz="0.0" iyy="0.00510825" iyz="0.0" izz="0.00510825"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.16"/>
      </geometry>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <material name="ur_gray"/>
    </visual>
  </link>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.135 0" rpy="0 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="56"/>
  </joint>

  <link name="wrist_3_link">
    <inertial>
      <origin xyz="0 0.092 0" rpy="0 1.5708 0"/>
      <mass value="0.202"/>
      <inertia ixx="0.000204525" ixy="0.0" ixz="0.0" iyy="0.000144346" iyz="0.0" izz="0.000144346"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.14"/>
      </geometry>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <material name="ur_gray"/>
    </visual>
  </link>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.12" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="56"/>
  </joint>

  <link name="ee_link"/>
  <joint name="ee_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ee_link"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
  </joint>

  <link name="base_mount"/>
  <joint name="base_mount_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="base_mount"/>
    <origin xyz="0 0.115 0" rpy="3.14159 -1.5708 0"/>
  </joint>

  <link name="base2"/>
  <joint name="base2_joint" type="fixed">
    <parent link="base_mount"/>
    <child link="base2"/>
    <origin xyz="0 0 0.0038" rpy="0 0 -1.5708"/>
  </joint>

  <link name="gripper_command_link"/>
  <joint name="fingers_actuator" type="prismatic">
    <parent link="base2"/>
    <child link="gripper_command_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="255.0" velocity="255.0" effort="20.0"/>
  </joint>

  <link name="right_driver"/>
  <joint name="right_driver_joint" type="revolute">
    <parent link="base2"/>
    <child link="right_driver"/>
    <origin xyz="0 0.0306011 0.054904" rpy="1.5708 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.8" velocity="2.0" effort="20"/>
  </joint>

  <link name="right_coupler"/>
  <joint name="right_coupler_joint" type="revolute">
    <parent link="right_driver"/>
    <child link="right_coupler"/>
    <origin xyz="0 0.0315 -0.0041" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="0.0" velocity="2.0" effort="20"/>
  </joint>

  <link name="right_spring_link"/>
  <joint name="right_spring_link_joint" type="revolute">
    <parent link="base2"/>
    <child link="right_spring_link"/>
    <origin xyz="0 0.0132 0.0609" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.296706" upper="0.8" velocity="2.0" effort="20"/>
  </joint>

  <link name="right_follower"/>
  <joint name="right_follower_joint" type="revolute">
    <parent link="right_spring_link"/>
    <child link="right_follower"/>
    <origin xyz="0 0.055 0.0375" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.872664" upper="0.872664" velocity="2.0" effort="20"/>
  </joint>

  <link name="right_pad"/>
  <joint name="right_pad_joint" type="fixed">
    <parent link="right_follower"/>
    <child link="right_pad"/>
    <origin xyz="0 -0.0189 0.01352" rpy="0 0 0"/>
  </joint>

  <link name="left_driver"/>
  <joint name="left_driver_joint" type="revolute">
    <parent link="base2"/>
    <child link="left_driver"/>
    <origin xyz="0 -0.0306011 0.054904" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.8" velocity="2.0" effort="20"/>
  </joint>

  <link name="left_coupler"/>
  <joint name="left_coupler_joint" type="revolute">
    <parent link="left_driver"/>
    <child link="left_coupler"/>
    <origin xyz="0 0.0315 -0.0041" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="0.0" velocity="2.0" effort="20"/>
  </joint>

  <link name="left_spring_link"/>
  <joint name="left_spring_link_joint" type="revolute">
    <parent link="base2"/>
    <child link="left_spring_link"/>
    <origin xyz="0 -0.0132 0.0609" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.296706" upper="0.8" velocity="2.0" effort="20"/>
  </joint>

  <link name="left_follower"/>
  <joint name="left_follower_joint" type="revolute">
    <parent link="left_spring_link"/>
    <child link="left_follower"/>
    <origin xyz="0 0.055 0.0375" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.872664" upper="0.872664" velocity="2.0" effort="20"/>
  </joint>

  <link name="left_pad"/>
  <joint name="left_pad_joint" type="fixed">
    <parent link="left_follower"/>
    <child link="left_pad"/>
    <origin xyz="0 -0.0189 0.01352" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="ee_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="camera_color_frame"/>
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="-0.05 0 0" rpy="0 0 0"/>
  </joint>

  <!-- The camera looks backwards along the axis of the forearm, following the standard ROS image conventions -->
  <!-- https://github.com/ros2/common_interfaces/blob/rolling/sensor_msgs/msg/Image.msg#L7 -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 1.5708"/>
  </joint>

  <!-- For the sake of visibility, this is where the MuJoCo camera should end up -->
  <link name="camera_color_mujoco_frame"/>
  <joint name="camera_color_mujoco_joint" type="fixed">
    <parent link="camera_color_optical_frame"/>
    <child link="camera_color_mujoco_frame"/>
    <origin xyz="0 0 0" rpy="3.14159 0 0"/>
  </joint>

  <!-- In the URDF, the lidar sensor's Z-axis should point "up" so that the sensor data sweeps -->
  <!-- counter clockwise. We expect the X-axis to be in line with the first rangefinder's Z-axis. -->
  <link name="lidar_sensor_frame" />
  <joint name="lidar_sensor_link" type="fixed">
    <parent link="world"/>
    <child link="lidar_sensor_frame"/>
    <origin rpy="0 0 -1.5708" xyz="1.0 2.0 0"/>
  </joint>

  <!-- To test the model generation from tags within the URDF, we test that when both -->
  <!-- `use_mjcf_from_topic` and `use_pid` args are set to true -->
  <xacro:if value="$(eval use_mjcf_from_topic)">
    <xacro:if value="$(eval use_pid)">
      <mujoco_inputs>

        <!-- The contents of `raw_inputs` will be copied and pasted directly into the MJCF -->
        <raw_inputs>
          <option integrator="implicitfast"/>

          <default>
            <default class="visual">
              <geom group="2" type="mesh" contype="0" conaffinity="0"/>
            </default>
            <default class="collision">
              <geom group="3" type="mesh"/>
            </default>
          </default>

          <actuator>
            <position name="shoulder_pan_joint" joint="shoulder_pan_joint" kp="25000" dampratio="1.0" ctrlrange="-3.14159 3.14159" />
            <position name="shoulder_lift_joint" joint="shoulder_lift_joint" kp="25000" dampratio="1.0" ctrlrange="-6.28319 6.28319" />
            <position name="elbow_joint" joint="elbow_joint" kp="25000" dampratio="1.0" ctrlrange="-3.14159 3.14159" />
            <position name="wrist_1_joint" joint="wrist_1_joint" kp="5000" dampratio="1.0" ctrlrange="-6.28319 6.28319" />
            <position name="wrist_2_joint" joint="wrist_2_joint" kp="5000" dampratio="1.0" ctrlrange="-6.28319 6.28319" />
            <position name="wrist_3_joint" joint="wrist_3_joint" kp="5000" dampratio="1.0" ctrlrange="-6.28319 6.28319" />
            <position tendon="split" name="fingers_actuator" kp="1000" dampratio="3.0" ctrlrange="0 255" />
          </actuator>

          <tendon>
            <fixed name="split">
              <joint joint="right_driver_joint" coef="0.5"/>
              <joint joint="left_driver_joint" coef="0.5"/>
            </fixed>
          </tendon>

          <equality>
            <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
          </equality>

          <sensor>
            <rangefinder name="lidar" site="rf" />
          </sensor>
        </raw_inputs>

        <!-- Specific inputs that require processing from the conversion script-->
        <processed_inputs>
          <!-- Specifying decompose_mesh will set the `decompose` flag when using obj2mjcf -->
          <!-- <decompose_mesh mesh_name="forearm" threshold="0.05"/> -->

          <!-- The camera with the specified values will be added at the specified site name. -->
          <!-- The position and quaterinion will be filled in by the converter -->
          <camera site="camera_color_optical_frame" name="camera" fovy="58" mode="fixed" resolution="640 480"/>

          <!-- Adds a lidar tag below a site tag to support a lidar sensor. -->
          <!-- In the URDF, we assume that that the sensor frame has the Z-axis pointed directly up in the sensor -->
          <!-- frame. This tag will create rangefinders in the MJCF between min_angle and max_angle at each -->
          <!-- angle_increment rotated about the replicate frame's Y axis. The hardware intercface then combines -->
          <!-- them into a single LaserScan message. -->
          <lidar ref_site="lidar_sensor_frame" sensor_name="rf" min_angle="-0.3" max_angle="0.3" angle_increment="0.025" />

          <!-- The element with the type and name as listed below will be modified with the remaining attributes -->
          <!-- If the attribute already existed, it will be overwritten -->
          <!-- Note that the type and name elements are required -->
          <modify_element type="joint" name="shoulder_pan_joint" frictionloss="1.0" damping="10.0"/>
          <modify_element type="joint" name="shoulder_lift_joint" damping="10.0"/>
          <modify_element type="joint" name="elbow_joint" damping="5.0"/>
          <modify_element type="joint" name="wrist_1_joint" damping="2.0"/>
          <modify_element type="joint" name="wrist_2_joint" damping="2.0"/>
          <modify_element type="joint" name="wrist_3_joint" damping="2.0"/>
          <modify_element type="body" name="forearm_link" gravcomp="1.0"/>

        </processed_inputs>

        <!-- scene tag inside the xacro also allows to generate the mjcf description with the scene information -->
        <scene>
          <statistic center="0.4 0 0.4" extent="1"/>

          <visual>
            <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
            <rgba haze="0.15 0.25 0.35 1"/>
            <global azimuth="120" elevation="-20"/>
          </visual>

          <asset>
            <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
            <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
              markrgb="0.8 0.8 0.8" width="300" height="300"/>
            <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
          </asset>

          <worldbody>
            <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
          </worldbody>
        </scene>
      </mujoco_inputs>
    </xacro:if>
  </xacro:if>

  <!-- ROS2 Control Configuration -->
  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>

      <!-- Conditional mujoco_model parameter based on use_pid -->
      <xacro:if value="$(arg use_pid)">
        <param name="pids_config_file">$(find mujoco_ros2_control_demos)/config/mujoco_pid.yaml</param>
      </xacro:if>

      <xacro:unless value="$(arg use_mjcf_from_topic)">
        <xacro:if value="$(arg use_pid)">
            <param name="mujoco_model">
                $(find mujoco_ros2_control_demos)/demo_resources/scenes/scene_pid.xml
            </param>
        </xacro:if>

        <xacro:unless value="$(arg use_pid)">
          <param name="mujoco_model">$(find mujoco_ros2_control_demos)/demo_resources/scenes/ur10e_2f85_pose_scene.xml</param>
        </xacro:unless>
      </xacro:unless>

      <!-- Uncomment this to use the keyframe from shown file as the starting configuration. -->
      <!-- <param name="override_start_position_file">$(find mujoco_ros2_control_demos)/config/start_positions.xml</param> -->

      <!-- Override the slowdown settings in the Simulate App and run at 3x speed -->
      <param name="sim_speed_factor">1.0</param>

      <!-- Uncomment to start the simulation at a specific keyframe defined in the MJCF -->
      <!-- <param name="initial_keyframe">start_90</param> -->

      <!-- If set to true, will not launch the Simulate App window -->
      <param name="headless">$(arg headless)</param>

      <!-- Publish camera images at 6 hz -->
      <param name="camera_publish_rate">6.0</param>

      <!-- Publish lidar scans at 10 hz -->
      <param name="lidar_publish_rate">1.0</param>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="wrist_1_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="wrist_2_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="wrist_3_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="fingers_actuator">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="force"/>
    </joint>

    <!-- For cameras, the sensor name _must_ match the camera name in the MJCF -->
    <sensor name="camera">
      <!-- Parameters will be used as is -->
      <param name="frame_name">camera_color_mujoco_frame</param>
      <param name="info_topic">/camera/color/camera_info</param>
      <param name="image_topic">/camera/color/image_raw</param>
      <param name="depth_topic">/camera/aligned_depth_to_color/image_raw</param>
    </sensor>

    <!-- Lidar sensors are matched to a set of rangefinder sensors in the MJCF, which should be -->
    <!-- generated with the "<lidar>" inputs in the conversion script. The consiste of N rangefinders -->
    <!-- and will generally be of the form "<sensor_name>-01". These parameters should line up with -->
    <!-- those documented in the laserscan message. -->
    <sensor name="lidar">
      <param name="frame_name">lidar_sensor_frame</param>
      <param name="angle_increment">0.025</param>
      <param name="min_angle">-0.3</param>
      <param name="max_angle">0.3</param>
      <param name="range_min">0.05</param>
      <param name="range_max">10</param>
      <param name="laserscan_topic">/scan</param>
    </sensor>
  </ros2_control>
</robot>
