<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur5e_2f85">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool_frame"/>
  </group>

  <group name="gripper">
    <joint name="left_driver_joint"/>
  </group>

  <group name="arm_with_gripper">
    <group name="arm"/>
    <group name="gripper"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="0.0"/>
    <joint name="elbow_joint" value="0.0"/>
    <joint name="wrist_1_joint" value="0.0"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="left_driver_joint" value="0.0"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="left_driver_joint" value="0.72"/>
  </group_state>

  <end_effector name="robotiq_2f85" parent_link="tool_frame" group="gripper" parent_group="arm"/>

  <passive_joint name="right_driver_joint"/>
  <passive_joint name="left_coupler_joint"/>
  <passive_joint name="right_coupler_joint"/>
  <passive_joint name="left_spring_link_joint"/>
  <passive_joint name="right_spring_link_joint"/>
  <passive_joint name="left_follower_joint"/>
  <passive_joint name="right_follower_joint"/>

