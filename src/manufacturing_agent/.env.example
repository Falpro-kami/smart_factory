# =========================
# 必填：顶层 Agent / 模型配置
# =========================

# 顶层 Agent 运行时使用的通用 LLM API Key。
LLM_API_KEY=

# =========================
# 必填：Neo4j 连接配置
# =========================

# Neo4j MCP 服务连接 Neo4j 数据库使用的 URI。
NEO4J_URI=bolt://127.0.0.1:7687
# Neo4j 用户名。
NEO4J_USERNAME=neo4j
# Neo4j 密码。
NEO4J_PASSWORD=
# Neo4j 数据库名称。
NEO4J_DATABASE=neo4j

# =========================
# 必填：MySQL 连接配置
# =========================

# mysql_mcp_server_pro 使用的 MySQL 主机地址。
MYSQL_HOST=localhost
# MySQL 端口。
MYSQL_PORT=3306
# MySQL 用户名。
MYSQL_USER=
# MySQL 密码。
MYSQL_PASSWORD=
# 默认 MySQL 数据库名称。
MYSQL_DATABASE=

# =========================
# 可选：顶层 Agent 行为
# =========================

# ChatOpenAI 使用的模型名称。
AGENT_MODEL=deepseek-chat
# OpenAI 兼容 LLM 服务提供商的基础接口地址。
AGENT_BASE_URL=https://api.deepseek.com
# Agent 模型的温度参数。
AGENT_TEMPERATURE=0.2
# 默认注入给 Agent 的 system prompt。
AGENT_SYSTEM_PROMPT=你是一个智能助手

# FastAPI 后端适配层监听的主机地址。
AGENT_BACKEND_HOST=127.0.0.1
# FastAPI 后端适配层监听的端口。
AGENT_BACKEND_PORT=8000
# 后端适配层允许的跨域来源，多个值用逗号分隔。
AGENT_CORS_ORIGINS=*

# CLI 模式默认使用的 thread id。
CLI_THREAD_ID=1

# =========================
# 可选：LangSmith 追踪
# =========================

# LangSmith tracing 使用的 API Key。
LANGSMITH_API_KEY=
# LangSmith 的接口地址。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LangSmith 中使用的项目名称。
LANGSMITH_PROJECT=myAgent
# 是否开启 LangSmith tracing。
LANGSMITH_TRACING=true

# =========================
# 可选：Neo4j MCP 行为
# =========================

# Neo4j MCP 工具名称前缀，可选。
NEO4J_NAMESPACE=
# Neo4j MCP 传输模式，可选 stdio、http、sse。
NEO4J_TRANSPORT=stdio
# Neo4j MCP 在 HTTP/SSE 模式下绑定的主机地址。
NEO4J_MCP_SERVER_HOST=127.0.0.1
# Neo4j MCP 在 HTTP/SSE 模式下绑定的端口。
NEO4J_MCP_SERVER_PORT=8000
# Neo4j MCP 在 HTTP/SSE 模式下暴露的路径。
NEO4J_MCP_SERVER_PATH=/mcp/
# Neo4j MCP 服务允许的跨域来源，多个值用逗号分隔。
NEO4J_MCP_SERVER_ALLOW_ORIGINS=
# Neo4j MCP 服务允许访问的 Host，多个值用逗号分隔。
NEO4J_MCP_SERVER_ALLOWED_HOSTS=localhost,127.0.0.1
# Neo4j 读查询返回结果的可选 token 限制。
NEO4J_RESPONSE_TOKEN_LIMIT=
# Neo4j 读查询超时时间，单位秒。
NEO4J_READ_TIMEOUT=30
# Neo4j MCP 是否以只读模式运行。
NEO4J_READ_ONLY=false
# 图数据库 schema 检查默认采样数。
NEO4J_SCHEMA_SAMPLE_SIZE=1000

# =========================
# 可选：MySQL MCP 行为
# =========================

# MCP 服务使用的 MySQL 角色，例如 readonly 或 admin。
MYSQL_ROLE=readonly
# MySQL 连接池基础大小。
POOL_SIZE=10
# 超出基础连接池后允许额外创建的连接数。
POOL_MAX_OVERFLOW=20
# 连接池回收时间，单位秒。
POOL_RECYCLE=3600
# 连接池等待超时时间，单位秒。
POOL_TIMEOUT=30

# =========================
# 可选：OAuth / 登录演示配置
# =========================

# MySQL MCP OAuth 中间件使用的登录页面地址。
MCP_LOGIN_URL=http://localhost:3000/login
# 登录流程中使用的演示用户名。
OAUTH_USER_NAME=admin
# 登录流程中使用的演示密码。
OAUTH_USER_PASSWORD=admin

# =========================
# 可选：RocketMQ 工单分发
# =========================

# WorkOrderDelivery 工具使用的 NameServer 地址。
ROCKETMQ_NAMESRV_ADDR=192.168.1.10:9876
# WorkOrderDelivery 生产者组。
ROCKETMQ_PRODUCER_GROUP=PID_WORK_ORDER_DELIVERY
# 同步发送超时时间，单位毫秒。当前 Python 客户端不一定显式支持该参数，先作为配置保留。
ROCKETMQ_SEND_TIMEOUT_MS=30000

# =========================
# 可选：RocketMQ 设备回传
# =========================

# 设备端完成/状态回传必须发送到该 Topic，消费者据此更新 MySQL 工单状态。
ROCKETMQ_DEVICE_EVENT_TOPIC=DeviceEventReport
# Windows mqadmin 初始化回传 Topic 时使用的 RocketMQ 集群名。
ROCKETMQ_DEVICE_EVENT_TOPIC_CLUSTER=DefaultCluster
# 设备回传消费者组。
ROCKETMQ_DEVICE_EVENT_CONSUMER_GROUP=CID_DEVICE_EVENT_REPORT_CONSUMER
# 设备回传 Tag 过滤表达式，默认接收所有 Tag。
ROCKETMQ_DEVICE_EVENT_TAG=*
# Windows mqadmin 轮询参数。
ROCKETMQ_DEVICE_EVENT_BATCH_SIZE=32
ROCKETMQ_DEVICE_EVENT_POLL_SECONDS=2
